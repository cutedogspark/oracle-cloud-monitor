# === OCI 基本設定 ===
# Tenancy OCID（在 OCI Console → Profile → Tenancy 取得）
TENANCY_ID="ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxx"

# Compartment OCID（通常與 Tenancy 相同，或自建 Compartment）
COMPARTMENT_ID="ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxx"

# Region identifier（例如 ap-osaka-1, ap-tokyo-1, us-phoenix-1）
REGION="ap-osaka-1"

# Availability Domain（透過 oci iam availability-domain list 查詢）
AVAILABILITY_DOMAIN="mMaS:AP-OSAKA-1-AD-1"

# Subnet OCID（透過 oci network subnet list 查詢）
SUBNET_ID="ocid1.subnet.oc1.ap-osaka-1.xxxxxxxxxxxxxxxxxxxx"

# === 實例設定 ===
# ARM A1.Flex Image OCID（透過 scripts/oci-report.sh 查詢）
IMAGE_ID="ocid1.image.oc1.ap-osaka-1.xxxxxxxxxxxxxxxxxxxx"

# SSH 公鑰路徑
SSH_KEY_FILE="$HOME/.ssh/id_rsa.pub"

# 實例名稱
DISPLAY_NAME="my-free-a1"

# ARM A1 規格（免費上限: 4 OCPU / 24 GB）
OCPUS=4
MEMORY=24
BOOT_SIZE=150

# === 監控設定 ===
# 花費上限（USD），超過自動停機
COST_LIMIT=1.0

# ntfy.sh 通知 topic（可到 https://ntfy.sh 自訂）
NTFY_TOPIC="my-oci-notify"

# OCI ONS Topic OCID（選填，用於 email 通知）
# 建立方式: OCI Console → Application Integration → Notifications → Create Topic → 加入 email subscription
ONS_TOPIC_ID=""

# === SSH 登入通知 ===
# 啟用 SSH 登入時的 ntfy 推播通知（需搭配 PAM 設定）
SSH_NOTIFY_ENABLED="true"

# 通知優先級（low / default / high / urgent）
SSH_NOTIFY_PRIORITY="high"
