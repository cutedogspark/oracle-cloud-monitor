# === OCI Basic Configuration ===
# Tenancy OCID (found in OCI Console → Profile → Tenancy)
TENANCY_ID="ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxx"

# Compartment OCID (usually same as Tenancy, or custom Compartment)
COMPARTMENT_ID="ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxx"

# Region identifier (e.g., ap-osaka-1, ap-tokyo-1, us-phoenix-1)
REGION="ap-osaka-1"

# Availability Domain (query via oci iam availability-domain list)
AVAILABILITY_DOMAIN="mMaS:AP-OSAKA-1-AD-1"

# Subnet OCID (query via oci network subnet list)
SUBNET_ID="ocid1.subnet.oc1.ap-osaka-1.xxxxxxxxxxxxxxxxxxxx"

# === Instance Configuration ===
# ARM A1.Flex Image OCID (query via scripts/oci-report.sh images)
IMAGE_ID="ocid1.image.oc1.ap-osaka-1.xxxxxxxxxxxxxxxxxxxx"

# SSH public key path
SSH_KEY_FILE="$HOME/.ssh/id_rsa.pub"

# Instance name
DISPLAY_NAME="my-free-a1"

# ARM A1 specs (Free tier limit: 4 OCPU / 24 GB)
OCPUS=4
MEMORY=24
BOOT_SIZE=150

# === Monitoring Configuration ===
# Cost limit (USD), auto-stop when exceeded
COST_LIMIT=1.0

# === Notification Configuration ===
# OCI ONS Topic OCID (default notification method, sends via email)
# Setup steps:
#   1. OCI Console → Application Integration → Notifications → Create Topic
#   2. Under Topic, create Subscription → select Email → enter email address → confirm via received email
#   3. Fill in the Topic OCID below
ONS_TOPIC_ID=""

# ntfy.sh push notifications (optional, leave empty to disable)
# Usage: Install ntfy app on phone → subscribe to your configured topic
NTFY_TOPIC=""

# === Backup Configuration ===
# Number of backups to retain (Always Free limit: 5)
BACKUP_KEEP=5
# Backup type: INCREMENTAL (faster and smaller) or FULL
BACKUP_TYPE="INCREMENTAL"

# === SSH Login Notification ===
# Enable SSH login notification (requires PAM configuration, auto-installed by setup-cron.sh)
SSH_NOTIFY_ENABLED="true"
SSH_NOTIFY_PRIORITY="high"
